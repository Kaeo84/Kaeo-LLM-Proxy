<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
		<RootNamespace>Kaeo.LlmProxy.Module.CodeVector</RootNamespace>
		<AssemblyName>Kaeo LLM Proxy Module Code Vector Store</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- Module must ship neighbor runtime assemblies into its folder. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<!-- Shared libraries (contracts + infrastructure): compile-time only. The host always
				runs these and supplies the runtime copies, so the module's types unify with the
				host's at load time. ExcludeAssets=runtime;native drops the whole transitive subtree
				(Sqlite, Serilog, MCP, native e_sqlite3, ...) from the module's runtime graph; the
				ModuleBuild.targets host-shared list then strips the Core/Infrastructure assemblies
				themselves from the shipped output. -->
		<ProjectReference Include="..\Kaeo LLM Proxy Core\Kaeo LLM Proxy Core.csproj" Private="false" ExcludeAssets="runtime;native" />
		<ProjectReference Include="..\Kaeo LLM Proxy Infrastructure\Kaeo LLM Proxy Infrastructure.csproj" Private="false" ExcludeAssets="runtime;native" />
	</ItemGroup>

	<ItemGroup>
		<!-- Runtime dependencies unique to this module: shipped beside the module DLL and
			loaded into the module's own assembly load context. -->
		<PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
		<PackageReference Include="LibGit2Sharp" Version="0.30.0" />
		<PackageReference Include="LibGit2Sharp.NativeBinaries" Version="2.0.322" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.20.0" />
	</ItemGroup>

	<PropertyGroup>
		<IsModuleProject>true</IsModuleProject>
	</PropertyGroup>

	<Import Project="..\ModuleBuild.targets" />

</Project>
