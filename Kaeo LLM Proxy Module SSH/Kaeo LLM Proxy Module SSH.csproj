<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
		<RootNamespace>Kaeo.LlmProxy.Module.Ssh</RootNamespace>
		<AssemblyName>Kaeo LLM Proxy Module SSH</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWindowsForms>true</UseWindowsForms>
		<!-- Class libraries do not copy NuGet runtime assemblies by default; this module must
				 ship them beside its DLL so the module load context can resolve them. -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>

	<ItemGroup>
		<!-- Shared libraries (contracts + infrastructure): compile-time only. The host always
			 runs these and supplies the runtime copies, so the module's types unify with the
			 host's at load time. ExcludeAssets=runtime;native drops the whole transitive subtree
			 (Serilog, MCP, ...) from the module's runtime graph; the ModuleBuild.targets
			 host-shared list then strips the Core/Infrastructure assemblies themselves. -->
		<ProjectReference Include="..\Kaeo LLM Proxy Core\Kaeo LLM Proxy Core.csproj" Private="false" ExcludeAssets="runtime;native" />
		<ProjectReference Include="..\Kaeo LLM Proxy Infrastructure\Kaeo LLM Proxy Infrastructure.csproj" Private="false" ExcludeAssets="runtime;native" />
	</ItemGroup>

	<ItemGroup>
		<!-- Runtime dependency unique to this module: ships beside the module DLL and loads
			 into the module's own assembly load context. -->
		<PackageReference Include="SSH.NET" Version="2026.0.0" />
	</ItemGroup>

	<PropertyGroup>
		<IsModuleProject>true</IsModuleProject>
	</PropertyGroup>

	<Import Project="..\ModuleBuild.targets" />

</Project>
