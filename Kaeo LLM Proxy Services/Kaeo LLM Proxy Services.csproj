<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
		<RootNamespace>Kaeo.LlmProxy.Services</RootNamespace>
		<AssemblyName>Kaeo LLM Proxy Services</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kaeo LLM Proxy Core\Kaeo LLM Proxy Core.csproj" />
		<ProjectReference Include="..\Kaeo LLM Proxy Infrastructure\Kaeo LLM Proxy Infrastructure.csproj" />
	</ItemGroup>

	<!-- Serilog, ModelContextProtocol, and Microsoft.Data.Sqlite (with the pinned
		 SQLitePCLRaw.lib.e_sqlite3 2.1.12 override for GHSA-2m69-gcr7-jv3q) all flow
		 transitively from Infrastructure, so this library declares no packages of its own. -->

	<ItemGroup>
		<InternalsVisibleTo Include="Kaeo LLM Proxy" />
		<InternalsVisibleTo Include="Kaeo LLM Proxy.Tests" />
	</ItemGroup>

</Project>
