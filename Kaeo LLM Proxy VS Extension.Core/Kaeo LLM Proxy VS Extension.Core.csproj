<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- net48 only: this assembly is consumed solely by the VSIX (Kaeo VS Extension),
				 which must load in the .NET Framework VS host process. The standalone proxy
				 and tests use the separate "Kaeo LLM Proxy Core" project, not this one. -->
		<TargetFramework>net48</TargetFramework>
		<RootNamespace>Kaeo.LlmProxy.VSExtension.Core</RootNamespace>
		<AssemblyName>Kaeo LLM Proxy VS Extension.Core</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Pin the language version so the net48 target still compiles the modern C#
				 used throughout (records, required, init, nullable). Without this the net48
				 build falls back to C# 7.3 and fails. -->
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="ModelContextProtocol" Version="2.2.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
	</ItemGroup>

	<!-- net48 lacks System.Text.Json and the async-enumerable/ValueTask shims in the BCL.
			 Both are supplied transitively by ModelContextProtocol (which ships netstandard2.0
			 assets and depends on them), so net48 resolves them automatically. On net10.0 they
			 are already in the framework, so these references are harmless there. -->
	<ItemGroup>
		<PackageReference Include="System.Text.Json" Version="10.0.10" />
		<PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Kaeo LLM Proxy.Tests" />
		<InternalsVisibleTo Include="Kaeo LLM Proxy VS Extension" />
		<InternalsVisibleTo Include="Kaeo VS Extension" />
	</ItemGroup>

</Project>
