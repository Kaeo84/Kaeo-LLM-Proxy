<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
		<RootNamespace>Kaeo.LlmProxy.WebSearch</RootNamespace>
		<AssemblyName>Kaeo LLM Proxy Web Search</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWindowsForms>true</UseWindowsForms>
	</PropertyGroup>

	<ItemGroup>
		<!-- Private=false: the contracts assembly ships with the host and unifies at runtime,
				 keeping this module's output a single DLL. -->
		<ProjectReference Include="..\Kaeo LLM Proxy Modules\Kaeo LLM Proxy Modules.csproj" Private="false" />
	</ItemGroup>

	<ItemGroup>
		<!-- Compile-time only: at runtime these unify with the host's copies, keeping this
				 module's output a single DLL. -->
		<PackageReference Include="ModelContextProtocol" Version="2.0.0" />
		<PackageReference Include="Serilog" Version="4.4.0" />
	</ItemGroup>

	<PropertyGroup>
		<IsModuleProject>true</IsModuleProject>
	</PropertyGroup>

	<Import Project="..\ModuleBuild.targets" />

</Project>
