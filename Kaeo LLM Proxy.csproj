<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>Kaeo.LlmProxy</RootNamespace>
    <AssemblyName>Kaeo LLM Proxy</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Kaeo LLM Proxy Core\Kaeo LLM Proxy Core.csproj" />
    <ProjectReference Include="Kaeo LLM Proxy Infrastructure\Kaeo LLM Proxy Infrastructure.csproj" />
    <ProjectReference Include="Kaeo LLM Proxy Services\Kaeo LLM Proxy Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kaeo LLM Proxy.Tests" />
  </ItemGroup>

  <!-- The host project lives at the repository root; keep sibling project sources out of its
       default glob so each library compiles only its own files. -->
  <ItemGroup>
    <Compile Remove="Kaeo LLM Proxy Core\**" />
    <Compile Remove="Kaeo LLM Proxy Infrastructure\**" />
    <Compile Remove="Kaeo LLM Proxy Services\**" />
    <Compile Remove="Kaeo LLM Proxy Modules\**" />
    <Compile Remove="Kaeo LLM Proxy Web Search\**" />
    <Compile Remove="Kaeo LLM Proxy SSH\**" />
    <Compile Remove="Kaeo LLM Proxy Code Vector Store\**" />
    <Compile Remove="Kaeo LLM Proxy.Tests\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy Core\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy Infrastructure\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy Services\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy Modules\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy Web Search\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy SSH\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy Code Vector Store\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy.Tests\**" />
    <None Remove="Kaeo LLM Proxy Core\**" />
    <None Remove="Kaeo LLM Proxy Infrastructure\**" />
    <None Remove="Kaeo LLM Proxy Services\**" />
    <None Remove="Kaeo LLM Proxy Modules\**" />
    <None Remove="Kaeo LLM Proxy Web Search\**" />
    <None Remove="Kaeo LLM Proxy SSH\**" />
    <None Remove="Kaeo LLM Proxy Code Vector Store\**" />
    <None Remove="Kaeo LLM Proxy.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <None Include="Kaeo LLM Proxy Code Vector Store\_gen.ps1" />
    <None Include="Kaeo LLM Proxy Code Vector Store\_gen1.ps1" />
    <None Include="Kaeo LLM Proxy Code Vector Store\_gen3.ps1" />
    <None Include="Kaeo LLM Proxy Code Vector Store\_gen4.ps1" />
    <None Include="Kaeo LLM Proxy Code Vector Store\_gen5.ps1" />
    <None Include="Kaeo LLM Proxy Code Vector Store\_gen6.ps1" />
    <!-- The App uses Serilog directly (startup logging); the other packages now live in the
         Core / Infrastructure / Services libraries and flow in transitively. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <!-- Module system: copy all module outputs (DLL + large deps) to $(OutputPath)Modules/ -->
  <PropertyGroup>
    <CopyModulesToHost>true</CopyModulesToHost>
  </PropertyGroup>
  <ItemGroup>
    <ModuleProject Include="Kaeo LLM Proxy Code Vector Store" />
    <ModuleProject Include="Kaeo LLM Proxy SSH" />
    <ModuleProject Include="Kaeo LLM Proxy Web Search" />
  </ItemGroup>

  <Import Project="ModuleBuild.targets" />

</Project>
