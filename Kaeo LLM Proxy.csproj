<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>Kaeo.LlmProxy</RootNamespace>
    <AssemblyName>Kaeo LLM Proxy</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Kaeo LLM Proxy Modules\Kaeo LLM Proxy Modules.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kaeo LLM Proxy.Tests" />
  </ItemGroup>

  <!-- The host project lives at the repository root; keep sibling project sources out of its
       default glob so each library compiles only its own files. -->
  <ItemGroup>
    <Compile Remove="Kaeo LLM Proxy Modules\**" />
    <Compile Remove="Kaeo LLM Proxy Web Search\**" />
    <Compile Remove="Kaeo LLM Proxy SSH\**" />
    <Compile Remove="Kaeo LLM Proxy.Tests\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy Modules\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy Web Search\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy SSH\**" />
    <EmbeddedResource Remove="Kaeo LLM Proxy.Tests\**" />
    <None Remove="Kaeo LLM Proxy Modules\**" />
    <None Remove="Kaeo LLM Proxy Web Search\**" />
    <None Remove="Kaeo LLM Proxy SSH\**" />
    <None Remove="Kaeo LLM Proxy.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="2.0.0" />
    <!-- Override transitive SQLitePCLRaw.lib.e_sqlite3 2.1.11 (GHSA-2m69-gcr7-jv3q) -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

</Project>
