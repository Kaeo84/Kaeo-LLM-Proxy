<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>Kaeo.LlmProxy.VSExtension</RootNamespace>
    <AssemblyName>Kaeo VS Extension</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- VSIX packaging: GeneratePkgDefFile is disabled because the CLI CreatePkgDef tool
       (.NET Framework) cannot load net10.0 type references. The .pkgdef will be generated
       by the VS IDE VSIX project system when building in Visual Studio. -->
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <GenerateVsix>false</GenerateVsix>
    <CreateVsixContainer>true</CreateVsixContainer>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <VsixSourceManifestPath>$(MSBuildProjectDirectory)\source.extension.vsixmanifest</VsixSourceManifestPath>
    <LoadVsixManifest>true</LoadVsixManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kaeo LLM Proxy VS Extension.Core\Kaeo LLM Proxy VS Extension.Core.csproj" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.14.40264" />
  </ItemGroup>

  <!-- VSCT command table -->
  <ItemGroup>
    <Vsct Include="Commands.vsct" />
  </ItemGroup>

</Project>
