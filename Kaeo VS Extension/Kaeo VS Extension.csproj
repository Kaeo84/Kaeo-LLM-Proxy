<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- net48 only: the VSIX must load in the .NET Framework VS host process (devenv.exe
         loads the package via mscoree.dll), so a pure net10.0 package cannot load.
         VSIX VSPackages are Visual Studio-only (VSCode uses a different model), so no
         net10 target is needed. -->
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Kaeo.LlmProxy.VSExtension</RootNamespace>
    <AssemblyName>Kaeo VS Extension</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Pin the language version so the net48 target still compiles the modern C# used
         throughout the extension (records, init, nullable). -->
    <LangVersion>latest</LangVersion>
    <UseWPF>true</UseWPF>
    <VSSDKBuildToolsAutoSetup>true</VSSDKBuildToolsAutoSetup>
    <CreateVsixContainer>true</CreateVsixContainer>
    <!-- CreatePkgDef is a .NET Framework tool; it can load this net48 package assembly,
         so VSSDK generates the full pkgdef (package registration, tool windows, and the
         [ProvideMenuResource] command-table entry). -->
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <VsixSourceManifestPath>$(MSBuildProjectDirectory)\source.extension.vsixmanifest</VsixSourceManifestPath>
    <LoadVsixManifest>true</LoadVsixManifest>
    <!-- WPF event handlers require async void; exceptions are handled in try/catch -->
    <NoWarn>$(NoWarn);VSTHRD100;VSTHRD101</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectCapability Include="CreateVsixContainer" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Community.VisualStudio.Toolkit.17" Version="17.0.551" />
    <PackageReference Include="Microsoft.VisualStudio.Shell.15.0" Version="17.14.40264" />
    <!-- ModelContextProtocol brings in netstandard2.0 polyfills needed by net48 -->
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <!-- net48 lacks System.Text.Json and the modern BCL polyfills; ModelContextProtocol and
         System.Text.Json pull them in transitively. VSSDK strips "shell-provided" assemblies
         from the VSIX payload, but the devenv copy has a different assembly version than these
         pins, so the extension's JSON/async save path throws FileNotFound at runtime. Force the
         whole set in (resolved from the extension folder by VS's AppDomain assembly probing).
         Versions match the net48 restore graph (obj/project.assets.json). -->
    <PackageReference Include="System.Text.Json" Version="10.0.12">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.12">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <PackageReference Include="System.IO.Pipelines" Version="10.0.12">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <PackageReference Include="System.Memory" Version="4.6.3">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <PackageReference Include="System.Buffers" Version="4.6.1">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.6.3">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <!-- Override transitive MessagePack (2.5.192) to resolve known vulnerabilities -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <!-- Microsoft.Extensions.AI (IChatClient, ChatMessage, ChatResponseUpdate, content types
         incl. TextReasoningContent) ships net462/netstandard2.0 assets, so it loads in the
         net48 VS host. Like System.Text.Json above, VSSDK treats Microsoft.Extensions.* as
         shell-provided and strips version-mismatched copies from the payload; force the
         MEAI assemblies in so the agent's streaming path resolves from the extension folder. -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.0">
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </PackageReference>
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="18.5.40034">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Shared wire-format <-> MEAI adapter (netstandard2.0, net48-compatible). IncludeInVSIX
       ships its dll in the extension payload so it resolves from the extension folder like
       the forced-in BCL packages above. -->
  <ItemGroup>
    <ProjectReference Include="..\Kaeo LLM Proxy VS Extension.Core\Kaeo LLM Proxy VS Extension.Core.csproj">
      <IncludeInVSIX>true</IncludeInVSIX>
    </ProjectReference>
  </ItemGroup>

  <!-- Allow tests to access internal types in the VS Extension assembly -->
  <ItemGroup>
    <InternalsVisibleTo Include="Kaeo LLM Proxy.Tests" />
  </ItemGroup>

  <!-- Compile Commands.vsct into the Menus.ctmenu command-table resource embedded in the
       package assembly. [ProvideMenuResource("Menus.ctmenu", 1)] on the package class +
       the VSSDK-generated pkgdef register it with VS so the View-menu button appears. -->
  <ItemGroup>
    <VSCTCompile Include="Commands.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
  </ItemGroup>

  <!-- Append a codeBase entry for the Core project assembly to the generated pkgdef.
       GeneratePkgDefFile only auto-registers ForceIncludeInVSIX packages (the Toolkit),
       so the IncludeInVSIX project reference (Kaeo LLM Proxy VS Extension.Core) would
       otherwise have no codeBase entry and the net48 host could fail to resolve it at the
       first send. Appended after CopyPkgDef (which writes the output pkgdef) and before the
       VSIX is created, so the entry ships in the container. Idempotent: skipped when the
       marker is already present (e.g. an incremental build that reuses the output pkgdef).
       Runs as a project target (not a post-build event) so it lands before VSIX creation. -->
  <Target Name="AppendCorePkgDef" AfterTargets="GeneratePkgDef" Condition="'$(GeneratePkgDefFile)'=='true'">
    <PropertyGroup>
      <_CorePkgdefFragment>$(MSBuildProjectDirectory)\KaeoCore.pkgdef</_CorePkgdefFragment>
      <!-- The VSIX ships the INTERMEDIATE pkgdef (see VSIXSourceItem above), so append
           there, not the OutDir copy. -->
      <_CorePkgdefOutput>$(IntermediateOutputPath)$(TargetName).pkgdef</_CorePkgdefOutput>
    </PropertyGroup>
    <!-- Append the fragment once; the section name in KaeoCore.pkgdef carries a marker so
         the check is idempotent across incremental builds. -->
    <Exec Condition="Exists('$(_CorePkgdefFragment)') AND Exists('$(_CorePkgdefOutput)')" ConsoleToMSBuild="true"
          Command="powershell -NoProfile -Command &quot;$pkgdef='$(_CorePkgdefOutput)'; $frag='$(_CorePkgdefFragment)'; if (-not (Get-Content -Raw $pkgdef).Contains('KAEoCorePkgDefSection')) { Add-Content -Path $pkgdef -Value (Get-Content -Raw $frag) }&quot;" />
  </Target>

</Project> 
