<ui:VsUIDialogWindow x:Class="Kaeo.LlmProxy.VSExtension.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
        
        toolkit:Themes.UseVsTheme="True"

        Title="Settings" Height="600" Width="800">

    <ui:VsUIDialogWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </ui:VsUIDialogWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ToolBar Grid.Row="0">
            <Button Content="Add Connection" Click="AddConnection_Click" />
            <Separator />
            <Button Content="Refresh All" Click="RefreshAll_Click" />
        </ToolBar>

        <TabControl Grid.Row="1">
            <TabItem Header="Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded}" Margin="0,2">
                                    <StackPanel Margin="4">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <TextBlock Grid.Column="2" Text="URL:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Grid.Column="3" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <CheckBox Grid.Column="4" Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Grid.Column="5" Content="Refresh" Click="RefreshConnection_Click" IsEnabled="{Binding CanRefresh}" MinWidth="70" Margin="0,0,8,0" />
                                            <Button Grid.Column="6" Content="Delete" Click="DeleteConnection_Click" MinWidth="60" />
                                        </Grid>

                                        <TextBlock Text="{Binding RefreshError}" Foreground="Red" Margin="0,0,0,4" Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                                        <DataGrid ItemsSource="{Binding Models}"
                                                    AutoGenerateColumns="False"
                                                    CanUserAddRows="False"
                                                    IsReadOnly="False"
                                                    HeadersVisibility="Column"
                                                    Margin="0,0,0,4">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Model Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Model ID" Binding="{Binding ModelId}" Width="*" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Capabilities" Binding="{Binding Capabilities}" Width="*" IsReadOnly="True" />
                                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="Auto" />
                                                <DataGridCheckBoxColumn Header="Default" Binding="{Binding IsPinned}" Width="Auto" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>
        </TabControl>

            </Grid>

        </ui:VsUIDialogWindow>