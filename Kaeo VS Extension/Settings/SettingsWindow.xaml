<Window x:Class="Kaeo.LlmProxy.VSExtension.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Kaeo.LlmProxy.VSExtension.Settings"
        xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"

        Title="Settings" Height="800" Width="1024"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        vsui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True"
        Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
        Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}">

    <Window.Resources>
        <!--
            THEME NOTE (applies to the whole Settings window):
            Every GUI element here MUST use Visual Studio theme brushes (DynamicResource via
            VsBrushes.* / VsColors.*) for foreground, background, borders and text, and must
            repaint automatically when the user changes the selected VS color scheme. Do NOT use
            hardcoded colors (Brushes.Black, #RRGGBB, etc.) for content that has to stay legible -
            they break dark/light themes. ThemedDialogStyleLoader themes the common controls;
            anything drawn manually (list item text, status/error lines, markers) must bind to a
            DynamicResource brush, not a converter that returns a fixed color.
        -->
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ThemedDialogStyleLoader (set on the root) already themes Button/CheckBox/
             TextBox/ComboBox/ListView/etc. - exactly how the tool window works. Only the
             DataGrid and the TabControl content surface need explicit brushes. -->

        <!-- Tabs -->
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Padding" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TabPanel x:Name="HeaderPanel" Grid.Row="0" IsItemsHost="True"
                                      Margin="2,2,2,0" Background="Transparent" Panel.ZIndex="1"
                                      KeyboardNavigation.TabIndex="1" />
                            <Border Grid.Row="1"
                                    Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="1"
                                    KeyboardNavigation.TabIndex="2"
                                    KeyboardNavigation.DirectionalNavigation="Contained">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTabTextKey}}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent"
                                BorderThickness="0,0,0,2"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter x:Name="Content" ContentSource="Header"
                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTabMouseOverBackgroundBeginKey}}" />
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTabMouseOverTextKey}}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTabSelectedTabKey}}" />
                                <Setter TargetName="Content" Property="TextElement.Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTabSelectedTextKey}}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Connection expanders -->
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border BorderBrush="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}"
                                BorderThickness="1">
                            <DockPanel>
                                <ToggleButton DockPanel.Dock="Top"
                                              Content="{TemplateBinding Header}"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              Cursor="Hand">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeadBd" Padding="6,4"
                                                    Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientBeginKey}}">
                                                <StackPanel Orientation="Horizontal"
                                                            TextElement.Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}">
                                                    <TextBlock x:Name="Arrow" Text="&#xE76D;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,6,0"
                                                               Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
                                                    <ContentPresenter VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="&#xE70E;" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="HeadBd" Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.CommandBarMouseOverBackgroundGradientKey}}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="Body" Visibility="Collapsed" />
                            </DockPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Model grid -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.GridHeadingBackgroundKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.GridHeadingTextKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.GridLineKey}}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="Padding" Value="4,2" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.HighlightKey}}" />
                    <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.HighlightTextKey}}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.HighlightKey}}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}" />
            <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBorderKey}}" />
            <Setter Property="RowBackground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}" />
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource {x:Static shell:VsBrushes.GridLineKey}}" />
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource {x:Static shell:VsBrushes.GridLineKey}}" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0">
            <TabItem Header="Models">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="4"
                            BorderThickness="0,0,0,1"
                            BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}"
                            Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarMenuBackgroundGradientKey}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Add Connection" Click="AddConnection_Click" Padding="10,2" Margin="0,0,4,0" />
                            <Button Content="Refresh All" Click="RefreshAll_Click" Padding="10,2" />
                        </StackPanel>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="6">
                    <ItemsControl ItemsSource="{Binding Connections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Header="{Binding Name}" IsExpanded="{Binding IsExpanded}" Margin="0,2">
                                    <StackPanel Margin="4">
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="120" VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <TextBlock Grid.Column="2" Text="URL:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <TextBox Grid.Column="3" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <TextBlock Grid.Column="4" Text="Upstream:" VerticalAlignment="Center" Margin="0,0,4,0" />
                                            <ComboBox Grid.Column="5" ItemsSource="{Binding UpstreamOptions}" SelectedItem="{Binding Upstream}" Width="110" VerticalAlignment="Center" Margin="0,0,8,0" />

                                            <CheckBox Grid.Column="6" Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <Button Grid.Column="7" Content="Refresh" Click="RefreshConnection_Click" IsEnabled="{Binding CanRefresh}" MinWidth="70" Margin="0,0,8,0" />
                                            <Button Grid.Column="8" Content="Copy" Click="CopyConnection_Click" MinWidth="60" Margin="0,0,8,0" />
                                            <Button Grid.Column="9" Content="Delete" Click="DeleteConnection_Click" MinWidth="60" />
                                        </Grid>

                                        <TextBlock Text="{Binding RefreshError}" Margin="0,0,0,4"
                                                   Foreground="#FFCE4747"
                                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />
                                        <DataGrid ItemsSource="{Binding Models}"
                                                    AutoGenerateColumns="False"
                                                    CanUserAddRows="False"
                                                    IsReadOnly="False"
                                                    HeadersVisibility="Column"
                                                    Margin="0,0,0,4">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Model Name" Binding="{Binding Name}" Width="*" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Model ID" Binding="{Binding ModelId}" Width="*" IsReadOnly="True" />
                                                <DataGridTextColumn Header="Capabilities" Binding="{Binding Capabilities}" Width="*" IsReadOnly="True" />
                                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="Auto" />
                                                <!--
                                                     The "Default" cell cannot be a DataGridCheckBoxColumn: that column type
                                                     never binds the visible checkbox to the row, it routes the toggle through
                                                     the DataGrid cell edit transaction. A cell that has been realized/edited
                                                     then keeps its own pending value, so when UnpinAllExcept clears a sibling's
                                                     IsPinned the stale checkmark stays on screen even though only one model is
                                                     actually the default. A read-only template column keeps the CheckBox bound
                                                     straight to the view model: the click commits at once (no two-click edit
                                                     mode) and an un-pinned sibling re-renders through the same binding.
                                                -->
                                                <DataGridTemplateColumn Header="Default" Width="Auto" IsReadOnly="True"
                                                                          CanUserSort="False">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsPinned, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="Agents">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <!-- Agent list capped at 25% of the tab width; the editor takes the rest. -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="New" Click="NewAgent_Click" MinWidth="60" Margin="0,0,4,0" />
                            <Button Content="Duplicate" Click="DuplicateAgent_Click" MinWidth="70" Margin="0,0,4,0" />
                            <Button Content="Delete" Click="DeleteAgent_Click" MinWidth="60" Margin="0,0,4,0" />
                            <Button Content="Make Default" Click="MakeDefaultAgent_Click" MinWidth="90"
                                    ToolTip="Use this agent by default in the chat window" />
                        </StackPanel>
                        <ListView x:Name="AgentsList"
                                  ItemsSource="{Binding Agents}"
                                  SelectionChanged="AgentsList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#x2605;" Width="16" Foreground="#FFFFC83D"
                                                   Visibility="{Binding IsDefault, Converter={StaticResource BoolToVis}}" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="AgentNameBox" Width="220" VerticalAlignment="Center"
                                     TextChanged="AgentEditor_TextChanged" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,4">
                            <TextBlock Text="Description:" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBox x:Name="AgentDescriptionBox" Width="320" VerticalAlignment="Center"
                                     TextChanged="AgentEditor_TextChanged" />
                        </StackPanel>

                        <TextBlock Grid.Row="2" Text="System prompt:" Margin="0,0,0,2" />
                        <TextBox Grid.Row="3" x:Name="AgentPromptBox"
                                 AcceptsReturn="True" AcceptsTab="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="12"
                                 Margin="0,0,0,4"
                                 TextChanged="AgentEditor_TextChanged" />

                        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="RevertAgentButton" Content="Revert to Default" Click="RevertAgent_Click"
                                    IsEnabled="False" MinWidth="110" Padding="10,2" Margin="0,0,4,0" />
                            <Button x:Name="SaveAgentButton" Content="Save" Click="SaveAgent_Click"
                                    IsEnabled="False" MinWidth="80" Padding="10,2" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="MCP">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <!-- Server list capped at 25% of the tab width; the editor takes the rest. -->
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>

                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="New" Click="NewMcpServer_Click" MinWidth="60" Margin="0,0,4,0" />
                            <Button x:Name="DeleteMcpButton" Content="Delete" Click="DeleteMcpServer_Click" MinWidth="60" />
                        </StackPanel>
                        <ListView x:Name="McpServersList"
                                  ItemsSource="{Binding McpServers}"
                                  SelectionChanged="McpServersList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <!--
                                         Themed foreground via DynamicResource so the text is readable in
                                         every VS color scheme and repaints when the theme changes. A
                                         disabled server dims to the theme's gray text instead of a
                                         hardcoded color.
                                    -->
                                    <TextBlock Text="{Binding Name}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground"
                                                        Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Foreground"
                                                                Value="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </DockPanel>

                    <TextBlock x:Name="NoMcpServerHint" Grid.Column="1" VerticalAlignment="Top"
                               Text="Select or add an MCP server to edit its tools."
                               Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />

                    <!-- DataContext is the selected server, assigned in McpServersList_SelectionChanged. -->
                    <Grid x:Name="McpEditor" Grid.Column="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--
                             Connection fields. Collapsed for the built-in VS tools server, which has no
                             transport/URL/command to configure.
                        -->
                        <Grid x:Name="McpConnectionFields" Grid.Row="0" Margin="0,0,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="Transport:" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <ComboBox Grid.Row="0" Grid.Column="3" Width="100" HorizontalAlignment="Left"
                                      ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding Transport}"
                                      VerticalAlignment="Center" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="URL:" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <TextBox Grid.Row="1" Grid.Column="1" IsEnabled="{Binding IsHttp}"
                                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="API key:" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <TextBox Grid.Row="1" Grid.Column="3" IsEnabled="{Binding IsHttp}"
                                     Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,0,0,4" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Command:" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <TextBox Grid.Row="2" Grid.Column="1" IsEnabled="{Binding IsStdio}"
                                     Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,0,8,4" />
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Arguments:" VerticalAlignment="Center" Margin="0,0,4,4" />
                            <TextBox Grid.Row="2" Grid.Column="3" IsEnabled="{Binding IsStdio}"
                                     Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Margin="0,0,0,4" />
                        </Grid>

                        <!-- Server-level actions. Test/Save are hidden for the built-in server. -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,2,0,4">
                            <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Button x:Name="TestMcpButton" Content="Test Connection" Click="TestMcpConnection_Click" IsEnabled="{Binding CanRefresh}"
                                    MinWidth="110" Margin="0,0,4,0" />
                            <Button x:Name="SaveMcpButton" Content="Save" Click="SaveMcpServer_Click" MinWidth="80" />
                        </StackPanel>

                        <!-- Tool-level actions. -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="Refresh Tools" Click="RefreshMcpTools_Click" IsEnabled="{Binding CanRefresh}"
                                    MinWidth="100" Margin="0,0,4,0" />
                            <Button Content="Enable All" Click="EnableAllTools_Click" MinWidth="80" Margin="0,0,4,0" />
                            <Button Content="Disable All" Click="DisableAllTools_Click" MinWidth="80" />
                            <TextBlock Text="{Binding ToolSummary}" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />
                        </StackPanel>

                        <!--
                             Feedback line. Successes are grey; errors are red, show the full detail
                             (including the stack trace) on hover, and copy it to the clipboard when clicked.
                        -->
                        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}"
                                   Margin="0,0,0,4" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}"
                                   Visibility="{Binding HasStatus, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="4"
                                   Text="{Binding LastError}" Margin="0,0,0,4" Foreground="#FFCE4747"
                                   TextTrimming="CharacterEllipsis" Cursor="Hand"
                                   ToolTip="{Binding LastErrorTooltip}"
                                   MouseLeftButtonUp="McpError_MouseLeftButtonUp"
                                   Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}" />

                        <DataGrid Grid.Row="5"
                                  ItemsSource="{Binding Tools}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <!--
                                     Read-only template column: the CheckBox binds straight to the row, so a
                                     toggle reaches the view model at once instead of waiting for the DataGrid
                                     cell edit transaction to commit (same reason as the Default column above).
                                -->
                                <DataGridTemplateColumn Header="Enabled" Width="Auto" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Tool" Binding="{Binding Name}" Width="Auto" IsReadOnly="True" />
                                <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="Instructions">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="3*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel Grid.Column="0" Margin="0,0,8,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="New Text" Click="NewTextInstruction_Click" MinWidth="80" Margin="0,0,4,0" />
                        <Button Content="New File" Click="NewFileInstruction_Click" MinWidth="80" Margin="0,0,4,0" />
                        <Button Content="Delete" Click="DeleteInstruction_Click" MinWidth="80" Margin="0,0,4,0" />
                        <Button Content="Move Up" Click="MoveInstructionUp_Click" MinWidth="80" Margin="0,0,4,0" />
                        <Button Content="Move Down" Click="MoveInstructionDown_Click" MinWidth="80" />
                    </StackPanel>

                    <ListBox x:Name="InstructionsList"
                             ItemsSource="{Binding Instructions}"
                             SelectionChanged="InstructionsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding KindLabel}" Margin="6,0,0,0"
                                               Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </DockPanel>

                    <TextBlock x:Name="NoInstructionHint" Grid.Column="1" VerticalAlignment="Top"
                               Text="Select or add an instruction source to edit it."
                               Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />

                    <!-- DataContext is the selected entry, assigned in InstructionsList_SelectionChanged. -->
                    <Grid x:Name="InstructionEditor" Grid.Column="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" VerticalAlignment="Center" Margin="0,0,4,4" />
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Margin="0,0,8,4" />
                        <ComboBox Grid.Row="0" Grid.Column="2" Width="90" HorizontalAlignment="Left"
                                  SelectedIndex="{Binding KindIndex, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,0,4">
                            <ComboBoxItem Content="Text" />
                            <ComboBoxItem Content="File" />
                        </ComboBox>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="File:" VerticalAlignment="Center" Margin="0,0,4,4"
                                   Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" />
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center" Margin="0,0,8,4"
                                 Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" />
                        <Button Grid.Row="1" Grid.Column="2" Content="Browse..." Click="BrowseInstructionFile_Click"
                                MinWidth="80" HorizontalAlignment="Left" Margin="0,0,0,4"
                                Visibility="{Binding IsFile, Converter={StaticResource BoolToVis}}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Text="Content:" Margin="0,0,0,2" />
                        <TextBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                 Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                 FontFamily="Consolas" FontSize="12" Margin="0,0,0,4" />

                        <StackPanel Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <CheckBox Content="Enabled" IsChecked="{Binding Enabled}" VerticalAlignment="Center" Margin="0,0,12,0" />
                            <Button Content="Save" Click="SaveInstruction_Click" MinWidth="80" Padding="10,2" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Outside the TabControl, so the Close action is available on every tab. -->
        <Border Grid.Row="1" Padding="6"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}"
                Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarMenuBackgroundGradientKey}}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" IsCancel="True" Click="Close_Click"
                        MinWidth="88" Padding="10,2"
                        AutomationProperties.Name="Close settings" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
