<vsui:DialogWindow x:Class="Kaeo.LlmProxy.VSExtension.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
        xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
        Title="Kaeo Assistant Settings" Height="600" Width="800"
        
        vsui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True">
    <Grid>
        <TabControl x:Name="MainTabControl">
            <TabItem Header="General" x:Name="TabGeneral">
                <StackPanel Margin="12">
                    <TextBlock Text="Defaults" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Default Agent:" VerticalAlignment="Center" Width="120" />
                        <ComboBox x:Name="DefaultAgentCombo" Width="200" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Default Mode:" VerticalAlignment="Center" Width="120" />
                        <ComboBox x:Name="DefaultModeCombo" Width="200" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Logging Level:" VerticalAlignment="Center" Width="120" />
                        <ComboBox x:Name="LoggingLevelCombo" Width="200" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
            <TabItem Header="Models" x:Name="TabModels">
                <DockPanel Margin="12">
                    <!-- Add-connection form -->
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="Add a connection" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBox x:Name="ConnNameBox" Width="140" Margin="4" VerticalAlignment="Center"
                                     ToolTip="Display name for this proxy connection"/>
                            <TextBox x:Name="ConnUrlBox" Width="260" Margin="4" VerticalAlignment="Center"
                                     ToolTip="Base URL of the Ollama-compatible proxy, e.g. http://localhost:8388"/>
                            <TextBox x:Name="ConnKeyBox" Width="160" Margin="4" VerticalAlignment="Center"
                                     ToolTip="Optional API key"/>
                            <Button x:Name="AddConnButton" Content="Add" Width="60" Margin="4" Click="AddConnButton_Click"/>
                            <Button x:Name="RefreshModelsButton" Content="Refresh models" Width="110" Margin="4" Click="RefreshModelsButton_Click"/>
                        </StackPanel>
                        <TextBlock x:Name="ModelsStatusText" Margin="4" Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}"/>
                    </StackPanel>

                    <!-- Connections → models tree -->
                    <TreeView x:Name="ConnectionsTree" Margin="0,8,0,0" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Agents" x:Name="TabAgents">
                <StackPanel Margin="12">
                    <TextBlock Text="Agents" FontWeight="Bold"/>
                    <ListBox x:Name="AgentsList" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="MCP" x:Name="TabMcp">
                <StackPanel Margin="12">
                    <TextBlock Text="MCP Servers" FontWeight="Bold"/>
                    <ListBox x:Name="McpServersList" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
        <Button Content="Close" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12" Width="80" Click="OnClose"/>
    </Grid>
</vsui:DialogWindow>