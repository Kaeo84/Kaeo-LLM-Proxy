<UserControl x:Class="Kaeo.LlmProxy.VSExtension.ToolWindow.ToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
             Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" vsui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Alert bar for unhealthy MCP servers (expandable) -->
        <Expander x:Name="McpAlertBar" Grid.Row="0"
                  IsExpanded="False"
                  Visibility="Collapsed"
                  Background="#FFFFE4B5"
                  BorderBrush="#FFFFA500"
                  BorderThickness="1"
                  Margin="4"
                  Padding="8,4">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock x:Name="McpAlertText" Text="Some MCP servers are unavailable"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Expander.Header>
            <TextBlock x:Name="McpAlertDetails" TextWrapping="Wrap"
                       Foreground="#FF333333" />
        </Expander>

        <!-- Top toolbar: Debug on the left, Export on the right. -->
        <Border Grid.Row="1" Padding="4,2"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}"
                Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientBeginKey}}">
            <DockPanel LastChildFill="False">
                <Button x:Name="DebugButton" DockPanel.Dock="Left" Width="26" Height="22" Padding="0"
                        ToolTip="Debug output"
                        AutomationProperties.Name="Debug output"
                        FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE90F;"
                        Click="DebugButton_Click" />
                <Button x:Name="ExportButton" DockPanel.Dock="Right" Width="26" Height="22" Padding="0"
                        ToolTip="Export conversation"
                        AutomationProperties.Name="Export conversation"
                        FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE8DE;"
                        Click="ExportButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="Markdown (.md)" Click="ExportMarkdown_Click" />
                            <MenuItem Header="Plain text (.txt)" Click="ExportPlainText_Click" />
                            <MenuItem Header="HTML (.html)" Click="ExportHtml_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
        </Border>

        <!-- Transcript: rows are multi-selectable (Ctrl/Shift+click) so several messages can be copied at once. -->
        <ListView x:Name="MessageList" Grid.Row="2" BorderThickness="0"
                  SelectionMode="Extended"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  HorizontalContentAlignment="Stretch">
            <ListView.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy"
                                CanExecute="CopySelected_CanExecute" Executed="CopySelected_Executed" />
            </ListView.CommandBindings>
            <ListView.InputBindings>
                <KeyBinding Gesture="Ctrl+C" Command="ApplicationCommands.Copy" />
            </ListView.InputBindings>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Selected" Command="ApplicationCommands.Copy" />
                    <MenuItem Header="Copy All" Click="CopyAll_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,4">
                        <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0"
                                   FontFamily="Consolas" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="warning">
                                            <Setter Property="Foreground" Value="#FFFF8C00" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Kind}" Value="error">
                                            <Setter Property="Foreground" Value="#FFFF4500" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Message input row -->
        <Grid Grid.Row="3" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PromptBox" Grid.Column="0" Margin="4" VerticalAlignment="Center"
                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="30" MaxHeight="80"
                     VerticalScrollBarVisibility="Auto" />
            <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="60" Margin="4" Click="SendButton_Click" />
            <!-- Icon-only to keep the input row narrow; the click handler is wired in code-behind. -->
            <Button x:Name="GearButton" Grid.Column="2" Width="28" Height="24" Margin="4" Padding="0"
                    ToolTip="Settings"
                    AutomationProperties.Name="Settings"
                    FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE713;" />
        </Grid>

        <!--
             Bottom bar: Agent/Mode/Model pills. Mode is a fixed width (about 16 characters) so it
             fits Interactive/Bypass/AutoPilot but can never grow; the model combo takes whatever
             width is left and clips long names instead of pushing the bar past the window edge.
        -->
        <Grid Grid.Row="4" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AgentCombo" Grid.Column="0" Width="140" Margin="4"
                      VerticalAlignment="Center" HorizontalAlignment="Left" />
            <ComboBox x:Name="ModeCombo" Grid.Column="1" Width="120" Margin="4"
                      VerticalAlignment="Center" HorizontalAlignment="Left" />
            <ComboBox x:Name="ModelCombo" Grid.Column="2" Margin="4"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="0" />
        </Grid>
    </Grid>
</UserControl>