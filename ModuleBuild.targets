<Project>

  <!--
	Shared build targets for the Kaeo LLM Proxy module system.

	Module projects import this and set <IsModuleProject>true</IsModuleProject> to:
	  - Embed small runtime dependencies into the module DLL (reduces file count)
	  - Assemblies in ModuleLargeDependencyNames stay as separate files

	The host project imports this and sets <CopyModulesToHost>true</CopyModulesToHost>
	  to automatically copy all module outputs into $(OutputPath)Modules/.

	To exclude a large dependency from embedding, add its assembly name (without .dll)
	to ModuleLargeDependencyNames (semicolon-separated) in the module's .csproj.
  -->

	<PropertyGroup>
	<!-- Semicolon-separated list of assembly names to exclude from embedding.
		 These stay as separate files alongside the module DLL. -->
	<ModuleLargeDependencyNames>Microsoft.ML.OnnxRuntime;Microsoft.Windows.SDK.NET</ModuleLargeDependencyNames>
	</PropertyGroup>

	<!-- ═══════════════════════════════════════════════════════════════════
		 Target for MODULE projects: embed small runtime dependencies
		 Runs before CoreCompile. The SDK's _GenerateCompileInputs target
		 (a CoreCompile dependency) populates _CoreCompileResourceInputs
		 from EmbeddedResource items, then our target adds module-specific
		 dependencies directly to _CoreCompileResourceInputs — the exact
		 item group the Csc task reads for its Resources parameter.
		 ═══════════════════════════════════════════════════════════════════ -->
	<Target Name="EmbedSmallModuleDependencies"
			BeforeTargets="CoreCompile"
			Condition="'$(IsModuleProject)' == 'true'">

	<!-- Build the list of files to embed from ReferenceCopyLocalPaths.
		 Filter: .dll extension AND empty DestinationSubDirectory (managed assemblies resolve to
		 the output root). Native assets are excluded below because, when building with a
		 RuntimeIdentifier, RID-specific native DLLs are ALSO flattened to the output root (empty
		 DestinationSubDirectory) and would otherwise be wrongly embedded. Native libraries must
		 ship as separate files on disk so the native loader can find them; embedding them as
		 resources breaks native resolution at load time.
		 Exclude the module's own DLL, contracts, and large dependencies. -->
	<ItemGroup>
		<ModuleEmbedCandidate Include="@(ReferenceCopyLocalPaths)"
		Condition="'%(ReferenceCopyLocalPaths.Extension)' == '.dll'
					 AND '%(ReferenceCopyLocalPaths.DestinationSubDirectory)' == ''" />
		<!-- Exclude the module's own DLL -->
		<ModuleEmbedCandidate Remove="@(ModuleEmbedCandidate)"
		Condition="'%(ModuleEmbedCandidate.Filename)%(ModuleEmbedCandidate.Extension)' == '$(AssemblyName).dll'" />
		<!-- Exclude host-shared assemblies (contracts + infrastructure) which ship with the host
			 and unify with the host's copies at runtime -->
		<ModuleEmbedCandidate Remove="@(ModuleEmbedCandidate)"
		Condition="'%(ModuleEmbedCandidate.Filename)' == 'Kaeo LLM Proxy Core'
						 OR '%(ModuleEmbedCandidate.Filename)' == 'Kaeo LLM Proxy Infrastructure'" />
		<!-- Exclude large dependencies -->
		<ModuleEmbedCandidate Remove="@(ModuleEmbedCandidate)"
		Condition="'%(ModuleEmbedCandidate.Filename)' == 'Microsoft.ML.OnnxRuntime'
						 OR '%(ModuleEmbedCandidate.Filename)' == 'Microsoft.Windows.SDK.NET'" />
		<!-- Exclude RID-specific native assets that must remain separate files on disk. Their
			 source path lives under runtimes/{rid}/native/ in the NuGet cache; when a
			 RuntimeIdentifier is set they flatten to the output root and would otherwise be
			 embedded. The Code Vector Store module embeds its LibGit2Sharp native library
			 (git2-*.dll) as a moduledep/ resource and extracts it at runtime (see
			 CodeVectorModule.EnsureLibGit2NativeLibraryAvailable), so it is intentionally NOT
			 excluded here. OnnxRuntime native stays separate (large). Add other native-providing
			 package IDs here as needed. -->
		<ModuleEmbedCandidate Remove="@(ModuleEmbedCandidate)"
			Condition="'%(ModuleEmbedCandidate.NuGetPackageId)' == 'Microsoft.ML.OnnxRuntime'" />
	</ItemGroup>

	<Message Importance="High"
		Text="ModuleBuild: Embedding @(ModuleEmbedCandidate->Count()) dependencies: @(ModuleEmbedCandidate->'%(Filename)%(Extension)', ', ')" />

	<!-- Add dependency DLLs directly to _CoreCompileResourceInputs — the item group the
		 Csc task reads for its Resources parameter. LogicalName produces /resource:file,
		 moduledep/name.dll flags; WithCulture=false satisfies the Csc condition filter.
		 This bypasses the GenerateResource/CreateManifestResourceNames pipeline (which
		 doesn't exist in projects without .resx files) and feeds resources straight to csc. -->
	<ItemGroup Condition="'@(ModuleEmbedCandidate)' != ''">
		<_CoreCompileResourceInputs Include="@(ModuleEmbedCandidate)">
			<LogicalName>moduledep/%(Filename)%(Extension)</LogicalName>
			<WithCulture>false</WithCulture>
		</_CoreCompileResourceInputs>
	</ItemGroup>

	<!-- Remove embedded dependencies from the copy-to-output list (they're now in the DLL) -->
	<ItemGroup Condition="'@(ModuleEmbedCandidate)' != ''">
		<ReferenceCopyLocalPaths Remove="@(ModuleEmbedCandidate)" />
	</ItemGroup>

	<!-- Remove host-shared assemblies from the copy-to-output list entirely. They unify with
		 the host's copies at runtime (the module load context defers to the default context),
		 so the module ships no redundant managed copy or debug symbols. -->
	<ItemGroup>
		<ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)"
		Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'Kaeo LLM Proxy Core'
						 OR '%(ReferenceCopyLocalPaths.Filename)' == 'Kaeo LLM Proxy Infrastructure'" />
	</ItemGroup>
	</Target>

  <!-- ═══════════════════════════════════════════════════════════════════
	   Target for HOST project: copy all module outputs to Modules/
	   Uses recursive glob (**\*.*) so that native dependency subdirectories
	   (runtimes/{rid}/native/) are preserved alongside the module DLL.
	   ═══════════════════════════════════════════════════════════════════ -->
  <Target Name="CopyModulesToHostOutput"
		  AfterTargets="Build"
		  Condition="'$(CopyModulesToHost)' == 'true'">

	<PropertyGroup>
	  <ModulesOutputDir>$(OutputPath)Modules</ModulesOutputDir>
	</PropertyGroup>

	<MakeDir Directories="$(ModulesOutputDir)" />

	<!-- Collect all files from each module's build output. The build is RID-specific
			 (Directory.Build.props sets RuntimeIdentifier), so each module's output lives under
			 bin\{Config}\{TFM}\{RID}\. Root the glob at that RID folder so %(RecursiveDir) is
			 relative to it — otherwise the module's own RID folder gets duplicated into
			 $(ModulesOutputDir) (e.g. Modules\win-x64\), which the host never probes. The host's
			 $(OutputPath) already includes the RID, so modules land flat in $(ModulesOutputDir).
			 When no RID is set the empty $(RuntimeIdentifier) collapses and this falls back to
			 collecting directly from the TFM output folder. -->
	<ItemGroup>
		<_ModuleOutputFiles Include="%(ModuleProject.Identity)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\**\*.*"
		Condition="Exists('%(ModuleProject.Identity)\bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)')" />
		<_ModuleOutputFiles Include="%(ModuleProject.Identity)\bin\$(Configuration)\$(TargetFramework)\**\*.*"
		Condition="'$(RuntimeIdentifier)' == '' and Exists('%(ModuleProject.Identity)\bin\$(Configuration)\$(TargetFramework)')" />
	</ItemGroup>

	<!-- Create subdirectories needed to preserve any sub-structure below the RID folder
			 (e.g. runtimes/{rid}/native/) -->
	<MakeDir Directories="@(_ModuleOutputFiles->'$(ModulesOutputDir)\%(RecursiveDir)')" />

	<!-- Copy preserving relative paths below the RID folder -->
	<Copy SourceFiles="@(_ModuleOutputFiles)"
			DestinationFiles="@(_ModuleOutputFiles->'$(ModulesOutputDir)\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true" />

	<Message Importance="Normal"
		Text="ModuleBuild: Copied @(_ModuleOutputFiles->Count()) files to $(ModulesOutputDir)" />
	</Target>

	<!-- ═══════════════════════════════════════════════════════════════════
		 Target for MODULE projects: copy this module's own build output into the
		 host's Modules/ folder. Runs after every module build so the host's
		 Modules/ directory always holds the latest module, even when only that
		 module (not the host) is built. The host's CopyModulesToHostOutput target
		 still runs on host builds to refresh all modules at once.
		 ═══════════════════════════════════════════════════════════════════ -->
	<Target Name="CopyModuleToHostOutput"
			AfterTargets="Build"
			Condition="'$(IsModuleProject)' == 'true'">

	<!-- The host lives at the repo root (where this targets file is). All projects share
		 the same TFM/RID, so the host's Modules/ folder is at a predictable path. -->
	<PropertyGroup>
		<_HostModulesDir>$(MSBuildThisFileDirectory)bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\Modules</_HostModulesDir>
	</PropertyGroup>

	<MakeDir Directories="$(_HostModulesDir)" />

	<!-- This module's own build output (module DLL + deps.json + shipped dependencies). -->
	<ItemGroup>
		<_ModuleOwnOutput Include="$(OutputPath)**\*.*" />
	</ItemGroup>

	<Copy SourceFiles="@(_ModuleOwnOutput)"
			DestinationFiles="@(_ModuleOwnOutput->'$(_HostModulesDir)\%(RecursiveDir)%(Filename)%(Extension)')"
			SkipUnchangedFiles="true" />

	<Message Importance="Normal"
		Text="ModuleBuild: Copied @(_ModuleOwnOutput->Count()) files from this module to $(_HostModulesDir)" />
	</Target>

	<!-- ═══════════════════════════════════════════════════════════════════════
		 Target for HOST project: remove the Modules folder on Clean so stale module
		 files (from a removed/renamed module, or a previous layout) do not linger.
		 The Modules folder is created by CopyModulesToHostOutput and is not part of
		 the normal build output, so the default Clean target never removes it.
		 ═══════════════════════════════════════════════════════════════════════ -->
	<Target Name="CleanModulesFromHostOutput"
			AfterTargets="Clean"
			Condition="'$(CopyModulesToHost)' == 'true'">
	<RemoveDir Directories="$(OutputPath)Modules" />
	</Target>

</Project>
