<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Kaeo.LlmProxy.Headless</RootNamespace>
		<AssemblyName>Kaeo LLM Proxy Headless</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Async suffix convention is used throughout for consistency (VSTHRD200). -->
		<NoWarn>$(NoWarn);VSTHRD200</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kaeo LLM Proxy Core\Kaeo LLM Proxy Core.csproj" />
		<ProjectReference Include="..\Kaeo LLM Proxy Infrastructure\Kaeo LLM Proxy Infrastructure.csproj" />
		<ProjectReference Include="..\Kaeo LLM Proxy Services\Kaeo LLM Proxy Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<!-- The headless host uses Serilog directly (startup logging); the other packages live in the
				 Core / Infrastructure / Services libraries and flow in transitively. -->
		<PackageReference Include="Serilog" Version="4.4.0" />
		<!-- Override transitive MessagePack to resolve known vulnerabilities; kept in lockstep with the
				 tray host and VS Extension so the wire format never skews. -->
		<PackageReference Include="MessagePack" Version="3.1.12" />
	</ItemGroup>

</Project>