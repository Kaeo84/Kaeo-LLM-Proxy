<Project Sdk="Microsoft.NET.Sdk">

	<!-- Shared wire-format <-> Microsoft.Extensions.AI adapter (MeaiAdapter). Multi-consumer:
			 the net48 VSIX references it for chat streaming; Services (net10) will reference it
			 for the Phase-B proxy IR translation (Plans\20260914-proxy-meai-phase-b-design.md);
			 the net10 test project references it directly (no source Compile-Link duplication).
			 netstandard2.0 because MEAI Abstractions ships netstandard2.0 assets, so one binary
			 serves net48 and net10 consumers. -->
	<PropertyGroup>
		<TargetFramework>netstandard2.0</TargetFramework>
		<!-- Directory.Build.props applies a global win-x64 RID for native-asset trimming;
				 a plain library has no native assets and must not be RID-scoped. -->
		<RuntimeIdentifier></RuntimeIdentifier>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Kaeo.LlmProxy.VSExtension.Core</RootNamespace>
		<AssemblyName>Kaeo LLM Proxy VS Extension.Core</AssemblyName>
	</PropertyGroup>

	<ItemGroup>
		<!-- ChatMessage / ChatResponseUpdate / content parts -->
		<PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.4.0" />
		<!-- netstandard2.0 lacks System.Text.Json; the extension already pins the same version
				 into the VSIX payload, so keep the shared library on the identical pin. -->
		<PackageReference Include="System.Text.Json" Version="10.0.8" />
		<!-- Roslyn for AST-aware editing (AstEditor) and post-edit syntax checks (SyntaxCheck).
				 5.12.0 matches the assembly version VS 2026 ships (5.12.0.0): devenv.exe.config
				 redirects 0.0.0.0-5.12.0.0 to its own LanguageServices copy, so the VSIX must NOT
				 bundle Roslyn (no ForceIncludeInVSIX in the extension) — same pattern as the BCL
				 pins. Its netstandard2.0 BCL dependencies (Immutable/Metadata/CodePages) are also
				 redirected to VS SharedAssemblies. Test consumers (net10) use the NuGet runtime. -->
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.12.0" />
	</ItemGroup>

</Project>
