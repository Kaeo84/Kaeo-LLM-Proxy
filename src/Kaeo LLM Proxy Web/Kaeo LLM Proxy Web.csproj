<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Kaeo.LlmProxy.Web</RootNamespace>
		<AssemblyName>Kaeo LLM Proxy Web</AssemblyName>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<!-- Async suffix convention is used throughout for consistency (VSTHRD200). -->
		<NoWarn>$(NoWarn);VSTHRD200</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- ASP.NET Core shared framework (Kestrel + Minimal APIs). Plain SDK + FrameworkReference
			 keeps this a portable host library started by the headless/tray hosts, identical on
			 Windows/Linux/macOS, with no web-SDK publish quirks. -->
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Kaeo LLM Proxy Core\Kaeo LLM Proxy Core.csproj" />
		<ProjectReference Include="..\Kaeo LLM Proxy Infrastructure\Kaeo LLM Proxy Infrastructure.csproj" />
		<ProjectReference Include="..\Kaeo LLM Proxy Services\Kaeo LLM Proxy Services.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Kaeo LLM Proxy" />
		<InternalsVisibleTo Include="Kaeo LLM Proxy Headless" />
		<InternalsVisibleTo Include="Kaeo LLM Proxy.Tests" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Serilog" Version="4.4.0" />
		<!-- Override transitive MessagePack to resolve known vulnerabilities; kept in lockstep with the
			 tray host, headless host and VS Extension so the wire format never skews. -->
		<PackageReference Include="MessagePack" Version="3.1.12" />
	</ItemGroup>

</Project>