<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <RootNamespace>Kaeo.LlmProxy</RootNamespace>
    <AssemblyName>Kaeo LLM Proxy</AssemblyName>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <!-- WinForms event handlers require async void (VSTHRD100) and the
         Async suffix convention is used throughout for consistency (VSTHRD200) -->
    <NoWarn>$(NoWarn);VSTHRD100;VSTHRD200</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kaeo LLM Proxy Core\Kaeo LLM Proxy Core.csproj" />
    <ProjectReference Include="..\Kaeo LLM Proxy Infrastructure\Kaeo LLM Proxy Infrastructure.csproj" />
    <ProjectReference Include="..\Kaeo LLM Proxy Services\Kaeo LLM Proxy Services.csproj" />
    <ProjectReference Include="..\Kaeo LLM Proxy Web\Kaeo LLM Proxy Web.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kaeo LLM Proxy.Tests" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\AppIcon.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <PackageReference Include="Microsoft.VisualStudio.Utilities" Version="17.14.40264" />
    <!-- The App uses Serilog directly (startup logging); the other packages now live in the
         Core / Infrastructure / Services libraries and flow in transitively. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <!-- Override transitive MessagePack (2.5.192) to resolve known vulnerabilities.
         Kept in lockstep with Kaeo VS Extension: the two processes exchange MessagePack
         payloads, so a version skew here is a wire-format risk, not just a build warning. -->
    <PackageReference Include="MessagePack" Version="3.1.12" />
  </ItemGroup>

  <!-- Module system: copy all module outputs (DLL + large deps) to $(OutputPath)Modules/ -->
  <PropertyGroup>
    <CopyModulesToHost>true</CopyModulesToHost>
  </PropertyGroup>
  <ItemGroup>
    <ModuleProject Include="..\Kaeo LLM Proxy Module Chat Interface" />
    <ModuleProject Include="..\Kaeo LLM Proxy Module Code Vector Store" />
    <ModuleProject Include="..\Kaeo LLM Proxy Module SSH" />
    <ModuleProject Include="..\Kaeo LLM Proxy Module Web Search" />
  </ItemGroup>

  <Import Project="..\ModuleBuild.targets" />

</Project>
