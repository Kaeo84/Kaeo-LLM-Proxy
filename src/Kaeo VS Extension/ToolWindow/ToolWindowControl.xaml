<UserControl x:Class="Kaeo.LlmProxy.VSExtension.ToolWindow.ToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vsui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:shell="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0"
             xmlns:local="clr-namespace:Kaeo.LlmProxy.VSExtension.ToolWindow"
             mc:Ignorable="d"
             d:DesignHeight="400" d:DesignWidth="600"
             Background="{DynamicResource {x:Static shell:VsBrushes.ToolWindowBackgroundKey}}"
                       Foreground="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" vsui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True">
             <UserControl.Resources>
                 <BooleanToVisibilityConverter x:Key="BoolToVis" />
                 <local:HexToBrushConverter x:Key="HexToBrush" />
                 <local:StringToHorizontalAlignmentConverter x:Key="AlignConv" />
                 <local:InvertBoolConverter x:Key="InvertBool" />
                 <!-- Inherit the Visual Studio environment font so all text matches the
                      rest of the IDE. Consolas overrides on code blocks stay explicit. -->
                 <Style TargetType="TextBlock">
                     <Setter Property="FontFamily" Value="{DynamicResource VsFont.EnvironmentFontFamily}" />
                     <Setter Property="FontSize" Value="{DynamicResource VsFont.EnvironmentFontSize}" />
                 </Style>
                 <Style TargetType="Control">
                     <Setter Property="FontFamily" Value="{DynamicResource VsFont.EnvironmentFontFamily}" />
                     <Setter Property="FontSize" Value="{DynamicResource VsFont.EnvironmentFontSize}" />
                 </Style>
             </UserControl.Resources>
             <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Alert bar for unhealthy MCP servers (expandable). Themed via info-bar
                     brushes so it stays legible in light and dark color schemes. -->
                <Expander x:Name="McpAlertBar" Grid.Row="0"
                          IsExpanded="False"
                          Visibility="Collapsed"
                          Background="{DynamicResource {x:Static shell:VsBrushes.InfoBackgroundKey}}"
                          BorderBrush="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}"
                          BorderThickness="1"
                          Margin="4"
                          Padding="8,4">
                    <Expander.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚠" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock x:Name="McpAlertText" Text="Some MCP servers are unavailable"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" />
                        </StackPanel>
                    </Expander.Header>
                    <TextBlock x:Name="McpAlertDetails" TextWrapping="Wrap"
                               Foreground="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" />
                </Expander>

        <!-- Top toolbar: Debug on the left, Export on the right. -->
        <Border Grid.Row="1" Padding="4,2"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource {x:Static shell:VsBrushes.CommandBarBorderKey}}"
                Background="{DynamicResource {x:Static shell:VsBrushes.CommandBarGradientBeginKey}}">
            <DockPanel LastChildFill="False">
                <Button x:Name="DebugButton" DockPanel.Dock="Left" Width="26" Height="22" Padding="0"
                        ToolTip="Debug output"
                        AutomationProperties.Name="Debug output"
                        FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE90F;"
                        Click="DebugButton_Click" />
                <Button x:Name="ExportButton" DockPanel.Dock="Right" Width="26" Height="22" Padding="0"
                        ToolTip="Export conversation"
                        AutomationProperties.Name="Export conversation"
                        FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE8DE;"
                        Click="ExportButton_Click">
                    <Button.ContextMenu>
                        <ContextMenu Placement="Bottom">
                            <MenuItem Header="Markdown (.md)" Click="ExportMarkdown_Click" />
                            <MenuItem Header="Plain text (.txt)" Click="ExportPlainText_Click" />
                            <MenuItem Header="HTML (.html)" Click="ExportHtml_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </DockPanel>
        </Border>

        <!-- Transcript: rows are multi-selectable (Ctrl/Shift+click) so several messages can be copied at once.
                     CanContentScroll="False" disables the default item-based scrolling (which jumps
                     by item height) in favor of smooth pixel scrolling. VirtualizingStackPanel.IsVirtualizing="False"
                     prevents the virtualizing panel from lazily measuring wrapped text, eliminating large scroll
                     jumps and blank/partial cards during manual scrolling. -->
                <ListView x:Name="MessageList" Grid.Row="2" BorderThickness="0"
                          SelectionMode="Extended"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                          ScrollViewer.CanContentScroll="False"
                          VirtualizingStackPanel.IsVirtualizing="False"
                          HorizontalContentAlignment="Stretch">
            <ListView.CommandBindings>
                <CommandBinding Command="ApplicationCommands.Copy"
                                CanExecute="CopySelected_CanExecute" Executed="CopySelected_Executed" />
            </ListView.CommandBindings>
            <ListView.InputBindings>
                <KeyBinding Gesture="Ctrl+C" Command="ApplicationCommands.Copy" />
            </ListView.InputBindings>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy Selected" Command="ApplicationCommands.Copy" />
                    <MenuItem Header="Copy All" Click="CopyAll_Click" />
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,4"
                                HorizontalAlignment="{Binding HorizontalAlignment, Converter={StaticResource AlignConv}}"
                                MaxWidth="520">
                        <TextBlock Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" Margin="0,0,0,2" />
                        <!-- Processing section: 3-level nested expander.
                             Level 1: entire Processing block (tools + thinking).
                             Level 2: Thinking sub-expander (model reasoning).
                             Level 3: Tools sub-expander (tool activity timeline).
                             Each level defaults to collapsed; Preferences set the defaults. -->
                        <Expander Visibility="{Binding HasProcessing, Converter={StaticResource BoolToVis}}"
                                  IsExpanded="{Binding DataContext.ProcessingExpanded, RelativeSource={RelativeSource AncestorType=ListView}, Mode=OneWay}"
                                  Header="{Binding ProcessingHeader}"
                                  FontSize="11" FontStyle="Italic" Margin="0,0,0,4"
                                  Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}">
                            <StackPanel Margin="12,2,0,2">
                                <!-- Level 2: Model reasoning (thinking). -->
                                <Expander x:Name="ThinkingExpander"
                                          Visibility="{Binding IsReasoningVisible, Converter={StaticResource BoolToVis}}"
                                          IsExpanded="{Binding DataContext.ReasoningExpanded, RelativeSource={RelativeSource AncestorType=ListView}, Mode=OneWay}"
                                          Header="Thinking"
                                          FontSize="11" FontStyle="Italic" Margin="0,0,0,4"
                                          Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}">
                                    <Border Margin="0,4,0,0"
                                            Background="{Binding DataContext.ReasoningBackgroundHex, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource HexToBrush}}">
                                        <TextBlock Text="{Binding Reasoning}" TextWrapping="Wrap"
                                                   FontStyle="Italic" FontSize="12"
                                                   Foreground="{Binding DataContext.ReasoningForegroundHex, RelativeSource={RelativeSource AncestorType=ListView}, Converter={StaticResource HexToBrush}, TargetNullValue={x:Null}}" />
                                    </Border>
                                </Expander>
                                <!-- Level 3: Tool-activity timeline. -->
                                <Expander x:Name="ToolsExpander"
                                          Visibility="{Binding HasTools, Converter={StaticResource BoolToVis}}"
                                          IsExpanded="{Binding DataContext.ToolsExpanded, RelativeSource={RelativeSource AncestorType=ListView}, Mode=OneWay}"
                                          Header="{Binding ProcessingHeader}"
                                          FontSize="11" FontStyle="Italic"
                                          Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}">
                                    <ItemsControl ItemsSource="{Binding Processing}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Expander>
                        <!-- Message text wrapped in a border so user/agent background colors render. -->
                        <Border Background="{Binding BackgroundHex, Converter={StaticResource HexToBrush}}"
                                CornerRadius="4" Padding="4,2">
                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Margin="0"
                                       FontFamily="Consolas" FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.ToolWindowTextKey}}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Kind}" Value="redirect">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.GrayTextKey}}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="warning">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="permission">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" />
                                                <Setter Property="FontStyle" Value="Italic" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Kind}" Value="error">
                                                <Setter Property="Foreground" Value="{DynamicResource {x:Static shell:VsBrushes.InfoTextKey}}" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <!-- Inline permission card actions: live until answered, then collapse. -->
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0"
                                    Visibility="{Binding ShowsApprovalButtons, Converter={StaticResource BoolToVis}}">
                            <Button Content="Allow" Padding="10,2" Margin="0,0,6,0" Click="AllowPermission_Click" />
                            <Button Content="Always allow" Padding="10,2" Margin="0,0,6,0" Click="AlwaysPermission_Click" />
                            <Button Content="Deny" Padding="10,2" Click="DenyPermission_Click" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

                <!-- Context usage bar: thin blue progress bar above the input row. Click = request compaction. -->
                <Grid Grid.Row="3" Margin="6,2,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="ContextBar" Grid.Column="0" Height="6"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding ContextPercent, Mode=OneWay}"
                                 ToolTip="{Binding ContextTooltip}"
                                 MouseLeftButtonUp="ContextBar_Click"
                                 Cursor="Hand"
                                 Foreground="#FF3A6EA5"
                                 BorderThickness="0" />
                    <Button x:Name="CompactButton" Grid.Column="1" Width="80" Height="20"
                            FontSize="10" Padding="4,0" Margin="6,0,0,0"
                            Content="Compact"
                            ToolTip="Request the model to summarize the conversation to reduce context usage"
                            Click="CompactButton_Click"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                </Grid>

                <!-- Message input row -->
        <Grid Grid.Row="4" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="PromptBox" Grid.Column="0" Margin="4" VerticalAlignment="Center"
                     TextWrapping="Wrap" AcceptsReturn="True" MinHeight="30" MaxHeight="80"
                     VerticalScrollBarVisibility="Auto" />
            <!-- One button, two states: Send when idle, Stop while a turn streams (IsBusy). -->
            <Button x:Name="SendButton" Grid.Column="1" Width="60" Margin="4" Click="SendButton_Click">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Content" Value="Send" />
                        <Setter Property="ToolTip" Value="Send the message (Enter)" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Content" Value="Stop" />
                                <Setter Property="ToolTip" Value="Stop the current turn" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <!-- Icon-only to keep the input row narrow; the click handler is wired in code-behind. -->
            <Button x:Name="GearButton" Grid.Column="2" Width="28" Height="24" Margin="4" Padding="0"
                    ToolTip="Settings"
                    AutomationProperties.Name="Settings"
                    FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE713;" />
        </Grid>

        <!--
             Bottom bar: Agent/Mode/Model pills. Mode is a fixed width (about 16 characters) so it
             fits Interactive/Bypass/AutoPilot but can never grow; the model combo takes whatever
             width is left and clips long names instead of pushing the bar past the window edge.
        -->
        <Grid Grid.Row="5" Margin="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="AgentCombo" Grid.Column="0" Width="140" Margin="4"
                      VerticalAlignment="Center" HorizontalAlignment="Left" />
            <ComboBox x:Name="ModeCombo" Grid.Column="1" Width="120" Margin="4"
                      VerticalAlignment="Center" HorizontalAlignment="Left" />
            <ComboBox x:Name="ModelCombo" Grid.Column="2" Margin="4"
                      VerticalAlignment="Center" HorizontalAlignment="Stretch" MinWidth="0" />
        </Grid>
    </Grid>
</UserControl>